# Settings that change per deployment — all of them are public values, not secrets.
# (A different value for any of these can also be set in the Vercel project's
#  Settings → Environment Variables; those win over this file when building there.)

# The address people open the app at, with https:// and without a trailing slash.
# Used for the link preview (og:image) and for the links inside shared messages.
# If you change the Vercel domain: update this line, then register the new address in
# Kakao Developers (see README.md).
VITE_APP_URL=https://travellog2.vercel.app

# Kakao Developers → 내 애플리케이션 → 플랫폼 키 → JavaScript 키 (public by design).
# Leave empty to hide the "카카오톡으로 카드 보내기" button.
VITE_KAKAO_JS_KEY=804a76627e9bb501d9bd51a4fd444284
